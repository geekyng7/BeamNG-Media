{
  "name": "beamng-media-bridge",
  "version": "1.0.0",
  "description": "Local Windows media bridge for a BeamNG.drive widget",
  "main": "src/main.cjs",
  "author": "geekyng7",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "generate:winrt": "dynwinrt-codegen generate --class-name Windows.Media.Control.GlobalSystemMediaTransportControlsSessionManager,Windows.Storage.Streams.DataReader,Windows.Storage.Streams.IRandomAccessStream --winmd \"C:\\Program Files (x86)\\Windows Kits\\10\\UnionMetadata\\10.0.26100.0\\Windows.winmd\" --output src/winrt-generated",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@microsoft/dynwinrt-codegen": "0.1.0-preview.23",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.beamng.media.bridge",
    "productName": "BeamNG Media Bridge",
    "directories": {
      "output": "BeamNG-Media"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "BeamNG-Media-Bridge-${version}-Setup.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  }
}
